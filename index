      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(payload, null, 2));
      const downloadAnchor = document.createElement("a");
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `whispers_letters_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function importDatabaseFromJson(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (parsed.letters && Array.isArray(parsed.letters)) {
            letters = parsed.letters;
            saveLetters();
          }
          if (parsed.config && typeof parsed.config === "object") {
            config = { ...config, ...parsed.config };
            saveConfig();
            applyTheme();
            applyDesignConfig();
          }
          renderAdminMessagesList();
          renderPlaylistUI();
          const notice = document.getElementById("syncStatusNotice");
          notice.textContent = "Letters restored successfully! ✨";
          setTimeout(() => notice.textContent = "Changes saved locally", 3000);
        } catch (err) {
          const notice = document.getElementById("syncStatusNotice");
          notice.textContent = "Could not parse JSON file.";
        }
      };
      reader.readAsText(file);
    }

