    function updateClocksAndTogetherDays() {
      const now = new Date();
      const utcTime = now.getTime() + (now.getTimezoneOffset() * 60000);
      const time1 = new Date(utcTime + (3600000 * parseFloat(config.offset1 || 0)));
      const time2 = new Date(utcTime + (3600000 * parseFloat(config.offset2 || 0)));

      const formatTime = d => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
      document.getElementById("time1Display").textContent = formatTime(time1);
      document.getElementById("time2Display").textContent = formatTime(time2);

      const startDateParts = (config.togetherStartDate || "2024-12-15").split("-");
      const startDate = new Date(parseInt(startDateParts[0]), parseInt(startDateParts[1]) - 1, parseInt(startDateParts[2]), 0, 0, 0);

      const diffMs = now.getTime() - startDate.getTime();
      if (diffMs >= 0) {
        const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        const totalHours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        document.getElementById("togetherCountDisplay").textContent = `${totalDays} Days, ${totalHours}h`;
      } else {
        document.getElementById("togetherCountDisplay").textContent = "Just beginning ❤️";
      }

      const formattedBadgeDate = `${startDateParts[2]}/${startDateParts[1]}/${startDateParts[0]}`;
      document.getElementById("startDateBadge").textContent = `Since ${formattedBadgeDate}`;
    }

    function selectLetterForViewing() {
      if (!letters || letters.length === 0) {
        currentLetter = {
          id: "empty",
          title: "Waiting for your words",
          category: "Welcome",
          date: new Date().toLocaleDateString(),
          content: "You haven't written any letters yet! Open the sender panel in the top right to write your notes or upload them in bulk.",
          favorite: false
        };
        return currentLetter;
      }

      if (config.deliveryMode === "sequential") {
        const sorted = [...letters].sort((a,b) => (a.readCount || 0) - (b.readCount || 0));
        currentLetter = sorted[0];
      } else if (config.deliveryMode === "daily") {
        const todayStr = new Date().toDateString();
        let hash = 0;
        for (let i = 0; i < todayStr.length; i++) {
          hash = (hash << 5) - hash + todayStr.charCodeAt(i);
        }
        const index = Math.abs(hash) % letters.length;
        currentLetter = letters[index];
      } else {
        const randomIndex = Math.floor(Math.random() * letters.length);
        currentLetter = letters[randomIndex];
      }

      return currentLetter;
    }

