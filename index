      document.getElementById("submitPinBtn").onclick = () => {
        const enteredPin = document.getElementById("pinInput").value;
        if (enteredPin === (config.adminPin || "1234")) {
          pinModal.classList.add("hidden");
          adminModal.classList.remove("hidden");
          renderAdminMessagesList();
          renderPlaylistUI();
        } else {
          document.getElementById("pinInput").classList.add("border-red-500");
          setTimeout(() => {
            document.getElementById("pinInput").classList.remove("border-red-500");
          }, 800);
        }
      };

      document.getElementById("pinInput").addEventListener("keydown", (e) => {
        if (e.key === "Enter") document.getElementById("submitPinBtn").click();
      });

      document.getElementById("closeAdminBtn").onclick = closeAdminModal;

      // Admin Tab Navigation
      document.querySelectorAll(".admin-tab").forEach(tab => {
        tab.onclick = () => {
          switchAdminTab(tab.getAttribute("data-tab"));
        };
      });

      document.getElementById("openBulkTabQuickBtn").onclick = () => {
        switchAdminTab("tab-bulk");
      };

      // Custom song addition
      document.getElementById("addCustomSongBtn").onclick = () => {
        const title = document.getElementById("customSongTitle").value.trim();
        const url = document.getElementById("customSongUrl").value.trim();
        if (title && url) {
          config.playlist.push({ title: title, tag: "Custom", url: url });
          saveConfig();
          renderPlaylistUI();
          document.getElementById("customSongTitle").value = "";
          document.getElementById("customSongUrl").value = "";
        }
      };

      // Bulk Upload Listeners
      document.getElementById("bulkFileInput").onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (evt) => {
          const content = evt.target.result;
          document.getElementById("bulkPasteTextarea").value = content;
          const parsed = parseBulkLettersRaw(content);
          stageBulkPreview(parsed);
        };
        reader.readAsText(file);
      };

      document.getElementById("processBulkBtn").onclick = () => {
        const raw = document.getElementById("bulkPasteTextarea").value;
        const parsed = parseBulkLettersRaw(raw);
        stageBulkPreview(parsed);
      };

      document.getElementById("insertSampleBulkBtn").onclick = () => {
        document.getElementById("bulkPasteTextarea").value = 
`Title: A night under the stars
Category: Special Memory
My love, remember that quiet drive when we stopped the car just to look up at the midnight sky? I still feel your hand in mine.
---
Title: Whenever the morning arrives
Category: Good Morning
Good morning sweetheart. Walk lightly today, breathe deeply, and smile knowing you are unconditionally cherished.
---
Title: Counting down the hours
Category: Reunion Dreams
Every morning brings us closer to being together again. Can't wait to wrap my arms around you.`;
      };

      document.getElementById("confirmBulkSaveBtn").onclick = () => {
        if (!stagedBulkLetters || stagedBulkLetters.length === 0) return;

        const importMode = document.querySelector('input[name="bulkImportMode"]:checked').value;
        if (importMode === "replace") {
          letters = [...stagedBulkLetters];
        } else {
          letters = [...stagedBulkLetters, ...letters];
        }

        saveLetters();
        renderAdminMessagesList();

        document.getElementById("bulkPreviewBox").classList.add("hidden");
        document.getElementById("bulkPasteTextarea").value = "";
        document.getElementById("bulkFileInput").value = "";

        const notice = document.getElementById("syncStatusNotice");
        notice.textContent = `Successfully imported ${stagedBulkLetters.length} letters! ✨`;
        setTimeout(() => notice.textContent = "Changes saved locally", 3500);

        switchAdminTab("tab-messages");
      };

      // Paper Style Selection
      document.querySelectorAll(".style-choice-btn").forEach(btn => {
        btn.onclick = () => {
          config.paperStyle = btn.getAttribute("data-style");
          applyDesignConfig();
          saveConfig();
        };
      });

      // Settings Inputs Handler
      const updateSettingsFromInputs = () => {
        config.fontFamily = document.getElementById("settingFontFamily").value;
        config.waxColor = document.getElementById("settingWaxColor").value;
        config.deliveryMode = document.getElementById("settingDeliveryMode").value;
        config.togetherStartDate = document.getElementById("settingTogetherStartDate").value || "2024-12-15";
        config.city1 = document.getElementById("settingCity1").value;
        config.offset1 = document.getElementById("settingOffset1").value;
        config.city2 = document.getElementById("settingCity2").value;
        config.offset2 = document.getElementById("settingOffset2").value;
        config.herName = document.getElementById("settingHerName").value;
        config.senderName = document.getElementById("settingSenderName").value;
        config.adminPin = document.getElementById("settingAdminPin").value || "1234";

        saveConfig();
        applyDesignConfig();
        updateClocksAndTogetherDays();
      };

      [
        "settingFontFamily", "settingWaxColor", "settingDeliveryMode", 
        "settingTogetherStartDate", "settingCity1", "settingOffset1", 
        "settingCity2", "settingOffset2", "settingHerName", "settingSenderName", "settingAdminPin"
      ].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener("change", updateSettingsFromInputs);
      });

      document.getElementById("saveAdminChangesBtn").onclick = () => {
        updateSettingsFromInputs();
        closeAdminModal();
      };

      // Single Message Form
      document.getElementById("addNewMessageBtn").onclick = () => openMessageEditor();
      document.getElementById("cancelEditBtn").onclick = closeMessageEditor;
      document.getElementById("cancelFormBtn").onclick = closeMessageEditor;

      document.getElementById("messageEditorForm").onsubmit = (e) => {
        e.preventDefault();
        const editId = document.getElementById("editLetterId").value;
        const title = document.getElementById("inputLetterTitle").value.trim();
        const category = document.getElementById("inputLetterCategory").value;
        const content = document.getElementById("inputLetterContent").value.trim();

        if (editId) {
          const idx = letters.findIndex(l => l.id === editId);
          if (idx !== -1) {
            letters[idx].title = title;
            letters[idx].category = category;
            letters[idx].content = content;
          }
        } else {
          const newLetter = {
            id: `letter-${Date.now()}`,
            title: title,
            category: category,
            date: new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
            content: content,
            favorite: false,
            readCount: 0
          };
          letters.unshift(newLetter);
        }

        saveLetters();
        renderAdminMessagesList();
        closeMessageEditor();
      };

      // Backup & Restore
      document.getElementById("exportDataBtn").onclick = exportDatabaseToJson;
      document.getElementById("importDataInput").onchange = importDatabaseFromJson;

      document.getElementById("resetDefaultsBtn").onclick = () => {
        letters = [...DEFAULT_LETTERS];
        saveLetters();
        renderAdminMessagesList();
      };
    });
  </script>
</body>
</html>
