    /* Bulk Upload Engine */
    function parseBulkLettersRaw(rawText) {
      if (!rawText || !rawText.trim()) return [];
      const trimmed = rawText.trim();

      if (trimmed.startsWith("[") || trimmed.startsWith("{")) {
        try {
          const parsed = JSON.parse(trimmed);
          if (Array.isArray(parsed)) {
            return parsed.map((item, idx) => sanitizeLetterObject(item, idx));
          }
          if (parsed.letters && Array.isArray(parsed.letters)) {
            return parsed.letters.map((item, idx) => sanitizeLetterObject(item, idx));
          }
        } catch (e) {}
      }

      const chunks = trimmed.split(/\n\s*(?:---+|===+|###\s+)\s*\n/);
      const parsedNotes = [];

      chunks.forEach((chunk, index) => {
        const cleanedChunk = chunk.trim();
        if (!cleanedChunk) return;

        let title = `Love Note #${letters.length + index + 1}`;
        let category = "Just Because";
        let date = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        let contentLines = [];

        const lines = cleanedChunk.split("\n");
        let parsingHeaders = true;

        for (let i = 0; i < lines.length; i++) {
          const line = lines[i];
          const lower = line.toLowerCase().trim();

          if (parsingHeaders && lower.startsWith("title:")) {
            title = line.substring(line.indexOf(":") + 1).trim();
          } else if (parsingHeaders && (lower.startsWith("category:") || lower.startsWith("tag:"))) {
            category = line.substring(line.indexOf(":") + 1).trim();
          } else if (parsingHeaders && lower.startsWith("date:")) {
            date = line.substring(line.indexOf(":") + 1).trim();
          } else {
            parsingHeaders = false;
            contentLines.push(line);
          }
        }

        const bodyContent = contentLines.join("\n").trim();
        if (bodyContent) {
          parsedNotes.push({
            id: `letter-${Date.now()}-${index}-${Math.floor(Math.random()*1000)}`,
            title: title || `Letter ${index + 1}`,
            category: category || "Just Because",
            date: date || new Date().toLocaleDateString(),
            content: bodyContent,
            favorite: false,
            readCount: 0
          });
        }
      });

      return parsedNotes;
    }

    function sanitizeLetterObject(item, idx) {
      return {
        id: item.id || `letter-${Date.now()}-${idx}`,
        title: item.title || `Letter #${idx + 1}`,
        category: item.category || "Just Because",
        date: item.date || new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
        content: item.content || item.text || item.body || "",
        favorite: !!item.favorite,
        readCount: item.readCount || 0
      };
    }

