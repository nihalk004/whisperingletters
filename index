<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Whispers Across the Miles</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            romantic: {
              50: '#fff1f2',
              100: '#ffe4e6',
              200: '#fecdd3',
              500: '#f43f5e',
              600: '#e11d48',
              900: '#881337',
            }
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Dancing+Script:wght@500;700&family=Kalam:wght@300;400;700&family=Marck+Script&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Sacramento&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    @keyframes floatPetal {
      0% {
        transform: translateY(-10vh) translateX(0) rotate(0deg);
        opacity: 0.9;
      }
      100% {
        transform: translateY(105vh) translateX(65px) rotate(360deg);
        opacity: 0.1;
      }
    }

    .petal {
      position: fixed;
      top: -40px;
      pointer-events: none;
      z-index: 15;
      animation: floatPetal linear infinite;
    }

    /* Paper Textures & Themes */
    .paper-parchment {
      background-color: #fbf5e8;
      background-image: radial-gradient(#eadbc5 1.1px, transparent 0);
      background-size: 24px 24px;
      color: #3b2f27;
      box-shadow: 0 15px 35px -5px rgba(114, 88, 59, 0.25), 0 0 0 1px rgba(181, 148, 107, 0.2);
    }
    .dark .paper-parchment {
      background-color: #24201c;
      background-image: radial-gradient(#3a3229 1.1px, transparent 0);
      color: #ede5da;
      box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(90, 75, 58, 0.35);
    }

    .paper-blush {
      background-color: #fff2f2;
      background-image: radial-gradient(#ffd4d4 1.2px, transparent 0);
      background-size: 22px 22px;
      color: #4a2c33;
      box-shadow: 0 15px 35px -5px rgba(180, 80, 100, 0.2), 0 0 0 1px rgba(230, 170, 180, 0.3);
    }
    .dark .paper-blush {
      background-color: #2b181e;
      background-image: radial-gradient(#4d2632 1.2px, transparent 0);
      color: #fed7e2;
      box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(120, 50, 70, 0.4);
    }

    .paper-midnight {
      background-color: #121324;
      color: #f1f1f8;
      background-image: radial-gradient(#2d2e54 1px, transparent 0);
      background-size: 20px 20px;
      box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(99, 102, 241, 0.25);
    }

    .paper-vintage-lines {
      background-color: #faf7ee;
      background-image: repeating-linear-gradient(transparent, transparent 31px, #e4dcbe 31px, #e4dcbe 32px);
      color: #382e25;
      box-shadow: 0 15px 35px -5px rgba(112, 100, 80, 0.25);
      line-height: 32px;
    }
    .dark .paper-vintage-lines {
      background-color: #1e1b18;
      background-image: repeating-linear-gradient(transparent, transparent 31px, #363028 31px, #363028 32px);
      color: #ece4d8;
      box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.7);
      line-height: 32px;
    }

    .paper-clean-cotton {
      background-color: #ffffff;
      color: #292524;
      box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.05);
    }
    .dark .paper-clean-cotton {
      background-color: #1c1917;
      color: #fafaf9;
      box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.07);
    }

    /* Wax Seal styling */
    .wax-seal {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 8px 20px rgba(0,0,0,0.35), inset 0 2px 4px rgba(255,255,255,0.4), inset 0 -3px 6px rgba(0,0,0,0.45);
    }
    .wax-seal:hover {
      transform: scale(1.08) rotate(3deg);
    }
    .wax-seal:active {
      transform: scale(0.95);
    }

    .envelope-flap-top {
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      transform-origin: top center;
    }
    .envelope-open .envelope-flap-top {
      transform: rotateX(180deg);
    }

    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(244, 63, 94, 0.3);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(244, 63, 94, 0.5);
    }
  </style>
</head>
<body class="min-h-screen bg-stone-100 text-stone-800 dark:bg-[#0f0e13] dark:text-stone-200 transition-colors duration-500 overflow-x-hidden select-none font-sans flex flex-col justify-between" id="appBody">

  <div id="ambientContainer" class="pointer-events-none fixed inset-0 overflow-hidden z-10"></div>

  <!-- Background Music Audio Player -->
  <audio id="bgMusicPlayer" preload="auto" loop></audio>

  <!-- Header -->
  <header class="relative z-20 w-full max-w-5xl mx-auto px-4 pt-4 pb-2 flex items-center justify-between">
    <div class="flex items-center space-x-2.5">
      <div class="h-9 w-9 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 flex items-center justify-center font-serif italic shadow-sm transition">
        <i class="fa-solid fa-heart text-sm animate-pulse"></i>
      </div>
      <div>
        <h1 class="text-sm sm:text-base font-semibold tracking-wide uppercase text-stone-700 dark:text-stone-200 font-serif" id="appHeading">Whispers Across The Miles</h1>
        <p class="text-[10px] sm:text-xs text-stone-400 dark:text-stone-500">Every whisper brings us closer</p>
      </div>
    </div>

    <!-- Quick controls -->
    <div class="flex items-center space-x-2 sm:space-x-2.5 text-stone-600 dark:text-stone-300">
      <!-- Dark/Light Mode toggle -->
      <button id="themeToggleBtn" title="Toggle Dark/Light Mode" aria-label="Toggle theme" class="p-2 w-9 h-9 rounded-full bg-white/80 dark:bg-stone-800/80 hover:bg-white dark:hover:bg-stone-700 backdrop-blur shadow-sm hover:text-rose-500 transition flex items-center justify-center border border-stone-200/50 dark:border-stone-700/60">
        <i class="fa-solid fa-moon text-xs sm:text-sm" id="themeIcon"></i>
      </button>

      <!-- Petal toggle -->
      <button id="togglePetalsBtn" title="Toggle Floating Petals" class="p-2 w-9 h-9 rounded-full bg-white/80 dark:bg-stone-800/80 hover:bg-white dark:hover:bg-stone-700 backdrop-blur shadow-sm hover:text-rose-500 transition flex items-center justify-center border border-stone-200/50 dark:border-stone-700/60 text-rose-500">
        <i class="fa-solid fa-spa text-xs sm:text-sm"></i>
      </button>

      <!-- Music ambience toggle -->
      <button id="toggleMusicBtn" title="Play Romantic / Harry Potter Music" class="p-2 w-9 h-9 rounded-full bg-white/80 dark:bg-stone-800/80 hover:bg-white dark:hover:bg-stone-700 backdrop-blur shadow-sm hover:text-rose-500 transition flex items-center justify-center border border-stone-200/50 dark:border-stone-700/60">
        <i class="fa-solid fa-music text-xs sm:text-sm" id="musicStatusIcon"></i>
      </button>

      <!-- Track Switcher Button -->
      <button id="nextTrackBtn" title="Next Song" class="p-2 w-9 h-9 rounded-full bg-white/80 dark:bg-stone-800/80 hover:bg-white dark:hover:bg-stone-700 backdrop-blur shadow-sm hover:text-rose-500 transition flex items-center justify-center border border-stone-200/50 dark:border-stone-700/60 text-xs">
        <i class="fa-solid fa-forward-step"></i>
      </button>

      <!-- Sender panel access -->
      <button id="adminKeyBtn" title="Control Panel" class="p-2 px-3 rounded-full bg-white/80 dark:bg-stone-800/80 hover:bg-white dark:hover:bg-stone-700 backdrop-blur shadow-sm text-xs font-medium hover:text-stone-900 dark:hover:text-white transition flex items-center space-x-1.5 border border-stone-200/50 dark:border-stone-700/60">
        <i class="fa-solid fa-feather text-[11px] text-rose-500"></i>
        <span class="hidden sm:inline">Sender Panel</span>
      </button>
    </div>
  </header>

  <!-- Now Playing Sub-bar -->
  <div class="relative z-20 w-full max-w-xl mx-auto px-4 text-center">
    <span id="nowPlayingText" class="text-[10px] text-stone-400 dark:text-stone-500 tracking-wide font-mono inline-flex items-center space-x-1.5 bg-white/40 dark:bg-stone-900/40 px-3 py-0.5 rounded-full border border-stone-200/40 dark:border-stone-800/40">
      <i class="fa-solid fa-compact-disc"></i>
      <span id="trackTitleDisplay">Hedwig's Theme (Lofi Magic Piano)</span>
    </span>
  </div>

  <!-- Status Bar: Time & Together Days Counter -->
  <section class="relative z-20 w-full max-w-xl mx-auto px-4 my-2">
    <div class="bg-white/70 dark:bg-stone-900/70 backdrop-blur-md border border-stone-200/60 dark:border-stone-800/80 rounded-2xl p-3 sm:p-3.5 shadow-sm grid grid-cols-3 items-center text-center">
      
      <!-- City 1 Time -->
      <div class="flex flex-col items-center">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400 dark:text-stone-500 truncate max-w-[85px] sm:max-w-none" id="city1Name">My Time</span>
        <span class="font-mono text-stone-700 dark:text-stone-200 font-semibold text-xs sm:text-sm mt-0.5" id="time1Display">--:--</span>
      </div>

      <!-- Days Together Counter -->
      <div class="px-2 border-x border-stone-200/70 dark:border-stone-800 flex flex-col items-center">
        <div class="flex items-center space-x-1 text-rose-500 dark:text-rose-400">
          <i class="fa-solid fa-heart text-[10px]"></i>
          <span class="text-[10px] uppercase font-bold tracking-wider">Days Together</span>
        </div>
        <span class="font-serif italic font-bold text-stone-800 dark:text-rose-200 text-sm sm:text-base tracking-tight mt-0.5" id="togetherCountDisplay">...</span>
        <span class="text-[9px] text-stone-400 dark:text-stone-500 font-mono mt-0.5" id="startDateBadge">Since 15/12/2024</span>
      </div>

      <!-- City 2 Time -->
      <div class="flex flex-col items-center">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400 dark:text-stone-500 truncate max-w-[85px] sm:max-w-none" id="city2Name">Her Time</span>
        <span class="font-mono text-stone-700 dark:text-stone-200 font-semibold text-xs sm:text-sm mt-0.5" id="time2Display">--:--</span>
      </div>

    </div>
  </section>

  <!-- Main Display Screen -->
  <main class="relative z-20 w-full max-w-3xl mx-auto px-4 py-4 my-auto flex flex-col items-center justify-center">

    <!-- View 1: Envelope Screen -->
    <div id="envelopeView" class="w-full max-w-md mx-auto transition-all duration-700 transform flex flex-col items-center">
      <div class="text-center mb-6">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-serif bg-rose-100 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 italic mb-2 tracking-wide border border-rose-200 dark:border-rose-900/50 shadow-sm">
          A note of love across the distance
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif text-stone-800 dark:text-stone-100 font-semibold" id="envelopeSalutation">To My Beloved</h2>
        <p class="text-xs text-stone-500 dark:text-stone-400 mt-1">Tap the warm wax seal to unfold today's note</p>
      </div>

      <!-- Tactile Envelope graphic -->
      <div class="relative w-72 sm:w-96 h-52 sm:h-56 rounded-2xl bg-amber-100/90 dark:bg-[#2b2520] shadow-2xl border border-amber-200/80 dark:border-stone-700/60 flex items-center justify-center overflow-hidden cursor-pointer group select-none transition-transform duration-300 hover:scale-[1.01]" id="envelopeWrapper">
        
        <!-- Flap Geometry -->
        <div class="envelope-flap-top absolute inset-x-0 top-0 h-0 border-t-[98px] sm:border-t-[115px] border-t-amber-200/90 dark:border-t-[#3b322a] border-l-[144px] sm:border-l-[192px] border-l-transparent border-r-[144px] sm:border-r-[192px] border-r-transparent pointer-events-none z-10 drop-shadow-sm"></div>
        <div class="absolute inset-x-0 bottom-0 h-0 border-b-[96px] sm:border-b-[110px] border-b-amber-200 dark:border-b-[#322a23] border-l-[144px] sm:border-l-[192px] border-l-amber-100 dark:border-l-[#26201b] border-r-[144px] sm:border-r-[192px] border-r-amber-100 dark:border-r-[#26201b] pointer-events-none z-0"></div>

        <!-- Airmail Postage Stamp -->
        <div class="absolute top-3 right-3 sm:top-4 sm:right-4 w-11 h-13 sm:w-12 sm:h-14 border-2 border-dashed border-rose-300 dark:border-rose-500/60 rounded bg-rose-50/70 dark:bg-rose-950/40 flex flex-col items-center justify-center rotate-3 shadow-inner pointer-events-none z-20">
          <i class="fa-solid fa-wand-sparkles text-rose-400 dark:text-rose-400 text-xs sm:text-sm"></i>
          <span class="text-[7px] sm:text-[8px] font-mono text-rose-500 dark:text-rose-400 mt-0.5 uppercase tracking-tighter">OWL POST</span>
        </div>

        <!-- Center Wax Seal Button -->
        <button id="waxSealBtn" aria-label="Break Wax Seal" class="wax-seal relative z-20 w-16 h-16 sm:w-20 sm:h-20 rounded-full flex flex-col items-center justify-center text-white cursor-pointer select-none">
          <i id="waxSealIcon" class="fa-solid fa-heart text-xl sm:text-2xl drop-shadow"></i>
          <span class="text-[8px] sm:text-[9px] font-serif tracking-widest mt-1 uppercase font-semibold text-rose-100">Break Seal</span>
        </button>
      </div>

      <div class="mt-6 sm:mt-8 flex items-center space-x-3">
        <button id="surpriseLetterBtn" class="text-xs bg-white/90 dark:bg-stone-800/90 hover:bg-white dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 px-4 py-2 rounded-full border border-stone-200 dark:border-stone-700 shadow-sm transition flex items-center space-x-2">
          <i class="fa-solid fa-shuffle text-rose-400"></i>
          <span>Pick random note</span>
        </button>
      </div>
    </div>

    <!-- View 2: Unfolded Letter Screen -->
    <div id="letterView" class="hidden w-full max-w-2xl mx-auto transition-all duration-700 transform flex flex-col items-center">
      
      <!-- Stationery Paper Container -->
      <article id="stationeryCard" class="w-full rounded-2xl p-6 sm:p-12 relative transition-all duration-300">
        
        <!-- Letter Header -->
        <div class="flex items-start justify-between border-b border-stone-300/40 dark:border-stone-700/60 pb-4 mb-6">
          <div class="pr-2">
            <span id="letterCategoryTag" class="text-[10px] sm:text-[11px] font-sans font-semibold tracking-wider uppercase px-2.5 py-1 rounded-full bg-rose-100 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300">
              Category
            </span>
            <h2 id="letterTitle" class="text-xl sm:text-2xl md:text-3xl font-serif font-bold mt-2 text-stone-800 dark:text-stone-100 break-words">
              Letter Title
            </h2>
          </div>
          <div class="text-right shrink-0">
            <span id="letterDate" class="text-xs font-serif italic text-stone-500 dark:text-stone-400 block">October 6, 2026</span>
            <button id="toggleFavoriteLetterBtn" title="Favorite this note" class="mt-1 text-stone-300 dark:text-stone-600 hover:text-rose-500 dark:hover:text-rose-400 transition text-lg p-1">
              <i class="fa-solid fa-heart" id="favHeartIcon"></i>
            </button>
          </div>
        </div>

        <!-- Handwritten Letter Body -->
        <div id="letterContent" class="text-base sm:text-xl md:text-2xl leading-relaxed whitespace-pre-line my-4 font-normal min-h-[140px]">
          Letter content goes here...
        </div>

        <!-- Signoff -->
        <div class="mt-8 pt-4 border-t border-stone-300/40 dark:border-stone-700/60 flex flex-col items-end">
          <span class="text-xs font-serif italic text-stone-400 dark:text-stone-500 mb-1" id="signoffLabel">Forever yours,</span>
          <span id="senderSignature" class="text-2xl sm:text-3xl font-serif italic font-semibold text-rose-800 dark:text-rose-300">Your Love</span>
        </div>

        <!-- Bottom stamp / counter -->
        <div class="absolute bottom-4 left-6 flex items-center space-x-2 opacity-60 text-stone-400 dark:text-stone-500 text-xs font-mono">
          <i class="fa-solid fa-feather"></i>
          <span id="letterCounterDisplay">Note #1</span>
        </div>
      </article>

      <!-- Letter Action Toolbar -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <button id="foldBackBtn" class="px-5 py-2.5 rounded-full bg-white/90 dark:bg-stone-800 text-stone-700 dark:text-stone-200 text-xs font-medium border border-stone-200 dark:border-stone-700 shadow-sm hover:shadow transition flex items-center space-x-2">
          <i class="fa-solid fa-envelope"></i>
          <span>Fold back & seal</span>
        </button>
        <button id="nextLetterBtn" class="px-5 py-2.5 rounded-full bg-rose-600 hover:bg-rose-700 text-white text-xs font-medium shadow-md transition flex items-center space-x-2">
          <span>Read another note</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>

    </div>

  </main>

  <footer class="relative z-20 py-3 text-center text-[11px] text-stone-400 dark:text-stone-600">
    <p>Crafted with love across the miles</p>
  </footer>

  <!-- Admin Modal -->
  <div id="adminModal" class="fixed inset-0 bg-stone-950/70 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-4 hidden">
    <div class="bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 rounded-3xl max-w-2xl w-full max-h-[92vh] shadow-2xl overflow-hidden flex flex-col border border-stone-200 dark:border-stone-800">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 border-b border-stone-100 dark:border-stone-800 flex items-center justify-between bg-stone-50 dark:bg-stone-900">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center text-xs shadow-sm">
            <i class="fa-solid fa-feather-pointed"></i>
          </div>
          <div>
            <h3 class="font-serif font-bold text-sm sm:text-base">Sender Control Room</h3>
            <p class="text-[11px] text-stone-500 dark:text-stone-400">Craft personal notes and manage letters in bulk</p>
          </div>
        </div>
        <button id="closeAdminBtn" aria-label="Close" class="w-8 h-8 rounded-full hover:bg-stone-200 dark:hover:bg-stone-800 text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 flex items-center justify-center transition">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex border-b border-stone-200 dark:border-stone-800 text-xs font-medium bg-stone-50/50 dark:bg-stone-900/50 px-4 sm:px-5 space-x-3 overflow-x-auto">
        <button class="admin-tab py-3 border-b-2 border-rose-600 text-rose-600 font-semibold whitespace-nowrap" data-tab="tab-messages">
          <i class="fa-solid fa-envelope-open-text mr-1"></i> Letters (<span id="msgCountBadge">0</span>)
        </button>
        <button class="admin-tab py-3 border-b-2 border-transparent text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 whitespace-nowrap" data-tab="tab-bulk">
          <i class="fa-solid fa-layer-group mr-1 text-rose-500"></i> Bulk Upload
        </button>
        <button class="admin-tab py-3 border-b-2 border-transparent text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 whitespace-nowrap" data-tab="tab-music">
          <i class="fa-solid fa-music mr-1 text-amber-500"></i> Music Playlist
        </button>
        <button class="admin-tab py-3 border-b-2 border-transparent text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 whitespace-nowrap" data-tab="tab-design">
          <i class="fa-solid fa-palette mr-1"></i> Aesthetics
        </button>
        <button class="admin-tab py-3 border-b-2 border-transparent text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 whitespace-nowrap" data-tab="tab-settings">
          <i class="fa-solid fa-sliders mr-1"></i> Settings
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-4 sm:p-6 overflow-y-auto flex-1 space-y-6">

        <!-- TAB 1: Letters Management -->
        <div id="tab-messages" class="admin-tab-content space-y-4">
          <div class="flex justify-between items-center">
            <h4 class="text-xs sm:text-sm font-semibold">Saved Handwritten Letters</h4>
            <div class="flex space-x-2">
              <button id="openBulkTabQuickBtn" class="bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-300 hover:bg-rose-100 text-xs px-3 py-1.5 rounded-full font-medium transition flex items-center space-x-1 border border-rose-200 dark:border-rose-900">
                <i class="fa-solid fa-layer-group text-[10px]"></i>
                <span>Bulk Upload</span>
              </button>
              <button id="addNewMessageBtn" class="bg-rose-600 hover:bg-rose-700 text-white text-xs px-3.5 py-1.5 rounded-full font-medium shadow-sm transition flex items-center space-x-1.5">
                <i class="fa-solid fa-plus text-[10px]"></i>
                <span>Write Note</span>
              </button>
            </div>
          </div>

          <div id="messagesListContainer" class="space-y-2.5 max-h-64 sm:max-h-72 overflow-y-auto pr-1"></div>

          <!-- Single Message Form -->
          <form id="messageEditorForm" class="hidden bg-stone-50 dark:bg-stone-800/60 p-4 rounded-2xl border border-stone-200 dark:border-stone-700 space-y-3">
            <div class="flex items-center justify-between">
              <h5 class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400" id="formHeading">Write New Note</h5>
              <button type="button" id="cancelEditBtn" class="text-stone-400 hover:text-stone-600 text-xs">Cancel</button>
            </div>
            
            <input type="hidden" id="editLetterId">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-medium mb-1">Note Title</label>
                <input type="text" id="inputLetterTitle" required placeholder="e.g. When the stars remind me of you" class="w-full text-xs px-3 py-2 rounded-lg border border-stone-300 dark:border-stone-600 dark:bg-stone-900 focus:outline-rose-500">
              </div>
              <div>
                <label class="block text-[11px] font-medium mb-1">Occasion / Tag</label>
