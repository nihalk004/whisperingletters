    function loadTrack(index) {
      const list = config.playlist || PLAYLIST;
      if (!list || list.length === 0) return;
      config.currentTrackIndex = (index + list.length) % list.length;
      const track = list[config.currentTrackIndex];
      bgPlayer.src = track.url;
      document.getElementById("trackTitleDisplay").textContent = `${track.title} [${track.tag || 'Romantic'}]`;
      saveConfig();
      renderPlaylistUI();
    }

